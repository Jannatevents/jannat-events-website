# Runtime configuration for the Node/Express API.
# Keep real values in the hosting provider's environment settings.
NODE_ENV=production
PORT=8080

# PostgreSQL connection string used by Drizzle.
DATABASE_URL=postgresql://user:password@host:5432/database

# Clerk values. These are server-side credentials; never commit real values.
CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=https://jannat.events,https://www.jannat.events

# Replit App Storage paths used by the current upload and asset routes.
# These values are required when the API runs on Replit.
PUBLIC_OBJECT_SEARCH_PATHS=/your-public-bucket-path
PRIVATE_OBJECT_DIR=/your-private-bucket-path

# Optional structured logger setting.
LOG_LEVEL=info