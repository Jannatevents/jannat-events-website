# Public values used by the Vite build. Never put secret keys in this file.
#
# The API origin only: do not add a trailing slash or /api.
VITE_API_BASE_URL=https://api.example.com

# Clerk publishable key. This is safe to expose in the browser.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_replace_me

# Optional when the API host serves the Clerk Frontend API proxy.
# For this project that is normally:
# VITE_CLERK_PROXY_URL=https://api.example.com/api/__clerk
VITE_CLERK_PROXY_URL=